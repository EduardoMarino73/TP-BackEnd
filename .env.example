# Copy this file to .env and fill in your own values.

# MySQL connection. MYSQL_DATABASE must match the database created by init.sql (che_netflix).
MYSQL_HOST=localhost
MYSQL_USER=admin
MYSQL_PASSWORD=password
MYSQL_PORT=3306
MYSQL_DATABASE=che_netflix

# HTTP port of the API.
PORT=3000

# Frontend origins allowed to call the API, separated by commas.
# Leave it empty to allow any origin (development only).
CORS_ORIGIN=http://localhost:5173

# Folder where uploaded videos and thumbnails are saved (relative to where the server starts).
CONTENT_DIR=src/Shared/database/content

# Upload limits, in megabytes.
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=5
